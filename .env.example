# Copy to .env.local for local development. In Vercel, add these under
# Project → Settings → Environment Variables. Never commit real values.

# Supabase → Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx   # (legacy "anon" key also works)

# SERVER ONLY — never prefix with NEXT_PUBLIC_. Used for invites & sign-in links.
SUPABASE_SECRET_KEY=sb_secret_xxx                         # (legacy "service_role" key also works)

# The public address of the site (used in invite / reset links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Shown in the header and browser tab
NEXT_PUBLIC_SITE_NAME=DCCW Golf
